{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-8 * * 1"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "vite-plus",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "vitest", "@vitest/**"]
    },
    {
      "groupName": "node",
      "matchPackageNames": ["node", "@types/node"]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "miniflare", "workerd", "@cloudflare/**"]
    },
    {
      "groupName": "effect",
      "matchPackageNames": ["effect", "@effect/**", "!@effect/tsgo"]
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react",
        "oxc-transform-react",
        "scheduler"
      ]
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"]
    },
    {
      "groupName": "design system",
      "matchPackageNames": [
        "baseui",
        "styletron-engine-monolithic",
        "styletron-react",
        "shadcn",
        "@shadcn/**",
        "cn",
        "class-variance-authority",
        "lucide-react"
      ]
    },
    {
      "groupName": "storybook",
      "matchPackageNames": ["storybook", "@storybook/**"]
    },
    {
      "groupName": "msw",
      "matchPackageNames": ["msw", "@msw/**", "msw-storybook-addon"]
    },
    {
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/**"]
    },
    {
      "groupName": "better-auth",
      "matchPackageNames": ["better-auth", "@better-auth/**"]
    },
    {
      "groupName": "drizzle",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"]
    },
    {
      "groupName": "alchemy",
      "matchPackageNames": ["alchemy", "@alchemy.run/**"]
    },
    {
      "groupName": "local observability services",
      "matchManagers": ["docker-compose"]
    },
    {
      "matchManagers": ["mise"],
      "matchPackageNames": ["Mergifyio/mergify-cli"],
      "versioning": "loose"
    },
    {
      "groupName": "k6",
      "matchPackageNames": ["@types/k6", "grafana/k6"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tools/load/src/releases\\.ts$/"],
      "matchStrings": ["const version = \"(?<currentValue>[^\"]+)\";"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "grafana/k6",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
