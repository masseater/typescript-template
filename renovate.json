{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-8 * * 1"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "vite-plus",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"]
    },
    {
      "matchPackageNames": ["vitest", "@vitest/**"],
      "enabled": false
    },
    {
      "groupName": "node",
      "matchPackageNames": ["node", "@types/node"]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "miniflare", "workerd", "@cloudflare/**"]
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react"
      ]
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"]
    },
    {
      "groupName": "design system",
      "matchPackageNames": [
        "@base-ui/**",
        "shadcn",
        "@shadcn/**",
        "cn",
        "class-variance-authority",
        "lucide-react"
      ]
    },
    {
      "groupName": "better-auth",
      "matchPackageNames": ["better-auth", "@better-auth/**"]
    },
    {
      "groupName": "drizzle",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"]
    },
    {
      "groupName": "pulumi",
      "matchPackageNames": ["@pulumi/**"]
    },
    {
      "groupName": "local observability services",
      "matchManagers": ["docker-compose"]
    }
  ]
}
