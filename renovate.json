{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "automerge": true,
  "ignoreTests": true,
  "platformAutomerge": false,
  "rollbackPrs": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "alchemy",
        "@alchemy.run/**",
        "@distilled.cloud/**"
      ],
      "groupName": "effect and alchemy"
    },
    {
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "/^(?:[7-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+(?:-(?:beta|rc)[0-9.]*)?$/"
    },
    {
      "matchFileNames": ["skills-lock.json"],
      "ignoreTests": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["masseater/typescript-template"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^skills-lock\\.json$/"],
      "matchStrings": [
        "\"source\": \"(?<depName>[^\"]+)\",\\s*\"ref\": \"(?<currentDigest>[0-9a-f]{40})\",\\s*\"sourceType\": \"github\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>masseater/typescript-template)/\\.github/actions/[a-z-]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"]
}
