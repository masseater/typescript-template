{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(alchemy unsafe*)",
      "Bash(alchemy destroy*)",
      "Bash(*/alchemy unsafe*)",
      "Bash(*/alchemy destroy*)",
      "Bash(* exec alchemy*)",
      "Bash(* dlx alchemy*)",
      "Bash(npx alchemy*)",
      "Bash(pnpx alchemy*)",
      "Bash(bunx alchemy*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/sync-base/cli.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/sync-base/cli.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/sync-base/cli.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/worktree-home/cli.ts"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/worktree-home/cli.ts"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && vp exec -F @repo/ai-native -- node --experimental-strip-types ./src/features/ai-native/worktree-home/cli.ts"
          }
        ]
      }
    ]
  }
}
