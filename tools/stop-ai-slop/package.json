{
  "name": "@template/stop-ai-slop",
  "version": "0.0.0",
  "description": "Machine-enforced checks for recurring low-value patterns in AI-authored changes.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "tools/stop-ai-slop"
  },
  "bin": {
    "stop-ai-slop": "./src/cli.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "stop-ai-slop": "./dist/cli.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "spool -- vp pack",
    "dev": "vp pack --watch",
    "test": "spool -- vp test",
    "check": "spool -- vp check",
    "check:skills": "intent validate",
    "typecheck": "spool -- tsc -p ."
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@template/ai-native": "workspace:*",
    "@template/lint-rule-authoring": "workspace:*",
    "es-toolkit": "catalog:",
    "oxc-parser": "catalog:",
    "parse-git-diff": "0.0.20"
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:",
    "@template/repository-checks": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
