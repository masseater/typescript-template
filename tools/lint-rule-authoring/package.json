{
  "name": "@template/lint-rule-authoring",
  "version": "0.0.0",
  "description": "Materials for authoring lint rules that keep working after they are written.",
  "keywords": [
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/mst",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/mst.git",
    "directory": "tools/lint-rule-authoring"
  },
  "bin": {
    "lint-rule-authoring": "./src/cli.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lint-rule-authoring": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./plugin": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "spool -- vp pack",
    "dev": "vp pack --watch",
    "test": "spool -- vp test",
    "check": "spool -- vp check",
    "check:skills": "intent validate",
    "typecheck": "spool -- tsc -p ."
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@template/ai-native": "workspace:*",
    "es-toolkit": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@tanstack/intent": "catalog:",
    "@template/repository-checks": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": "^0.3.2"
  },
  "lintRules": [
    "src/lint/oxlint/rules"
  ]
}
