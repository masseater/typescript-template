{
  "name": "typescript-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && node tools/dev/src/prepare-browser.ts",
    "check": "vp check && vp run knip && vp run check:staged",
    "check:staged": "node tools/quality/check-staged.ts",
    "lint": "vp lint --max-warnings 0",
    "lint:fix": "vp check --fix",
    "format": "vp fmt",
    "knip": "knip && knip --strict",
    "test": "vp test run",
    "build": "vp run -r build && vp run --filter @template/dev private-maps user && vp run --filter @template/dev private-maps admin && vp run --filter @template/dev private-maps wiki",
    "build:user": "vp run --filter @template/user build && vp run --filter @template/dev private-maps user",
    "build:admin": "vp run --filter @template/admin build && vp run --filter @template/dev private-maps admin",
    "build:wiki": "vp run --filter @template/wiki build && vp run --filter @template/dev private-maps wiki",
    "dev:setup": "vp run --filter @template/dev setup && vp run --filter @template/local prepare:local",
    "dev:start": "vp run --filter @template/dev start",
    "dev:stop": "vp run --filter @template/dev stop",
    "dev:status": "vp run --filter @template/dev status",
    "dev:logs": "vp run --filter @template/dev logs",
    "dev:browser": "vp run --filter @template/dev browser",
    "browser": "vp run --filter @template/dev browser-command",
    "dev:connect": "vp run --filter @template/dev connect",
    "services:config": "vp run --filter @template/local config",
    "services:up": "vp run --filter @template/local up",
    "services:status": "vp run --filter @template/local status",
    "services:logs": "vp run --filter @template/local logs",
    "observe": "vp run --filter @template/observe observe",
    "observe:verify": "vp run --filter @template/observe verify",
    "db:generate": "vp run --filter @template/db db:generate",
    "db:check": "vp run --filter @template/db db:check",
    "db:migrate:local": "vp run --filter @template/db db:migrate:local",
    "db:bootstrap:local": "vp run --filter @template/db db:bootstrap:local",
    "db:migrate:remote": "vp run --filter @template/infra-cloudflare db:migrate:remote",
    "db:bootstrap:remote": "vp run --filter @template/infra-cloudflare db:bootstrap:remote",
    "infra:bootstrap": "vp run --filter @template/infra-bootstrap setup",
    "infra:state": "vp run --filter @template/infra-bootstrap with-state",
    "infra:preview:shared": "vp run --filter @template/infra-cloudflare preview:shared",
    "infra:preview:user": "vp run --filter @template/infra-cloudflare preview:user",
    "infra:preview:admin": "vp run --filter @template/infra-cloudflare preview:admin",
    "infra:preview:wiki": "vp run --filter @template/infra-cloudflare preview:wiki",
    "infra:deploy:shared": "vp run --filter @template/infra-cloudflare deploy:shared",
    "infra:deploy:user": "vp run --filter @template/infra-cloudflare deploy:user",
    "infra:deploy:admin": "vp run --filter @template/infra-cloudflare deploy:admin",
    "infra:deploy:wiki": "vp run --filter @template/infra-cloudflare deploy:wiki",
    "test:e2e": "vp run --filter @template/e2e test",
    "test:e2e:unit": "vp run --filter @template/e2e test:unit",
    "test:artifacts": "vp run --filter @template/e2e test:artifacts && vp run --filter @template/infra-cloudflare verify:artifacts",
    "precommit": "vp run check",
    "prepush": "vp run check && vp run test && vp run test:e2e:unit && vp run build && vp run test:artifacts && vp run test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "knip": "6.35.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.1"
}
