{
  "name": "typescript-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "vp check && syncpack lint && vp run textlint && vp run -r steiger && vp run -r db:check && vp run -r fallow",
    "textlint": "textlint \"**/*.md\"",
    "fallow": "fallow --production --quiet --format compact && fallow dead-code --no-production --quiet --format compact && fallow dupes --quiet --format compact && fallow security --fail-on-issues --quiet",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@shadcn/lint": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-drizzle": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "fallow": "3.30.0",
    "jev-lint": "catalog:",
    "skills": "1.7.0",
    "syncpack": "catalog:",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "intent": {
    "skills": [
      "@tanstack/devtools-vite",
      "@tanstack/react-start",
      "drizzle-kit",
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/match-sorter-utils",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/virtual-file-routes",
      "@tanstack/router-plugin",
      "@tanstack/start-server-core",
      "fallow"
    ]
  }
}
