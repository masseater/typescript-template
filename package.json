{
  "name": "typescript-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bash -c 'export NODE_OPTIONS=--throw-deprecation; vp config --no-agent && vp run --filter @repo/dev prepare-browser && effect-tsgo patch --typescript --oxlint'"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mergifyio/vitest": "catalog:",
    "@repo/ai-native-telemetry": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/db-local": "workspace:*",
    "@repo/dont-review-it": "workspace:*",
    "@repo/monitor": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "knip": "6.35.1",
    "miniflare": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "textlint": "15.8.0",
    "textlint-rule-preset-ai-words-ja": "1.2.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.4.2",
  "normativeDocuments": {
    "fileName": "AGENTS.md",
    "directories": [
      ".claude/skills/reviews/references"
    ]
  }
