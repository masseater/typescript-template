{
  "name": "typescript-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && node tools/dev/src/prepare-browser.ts",
    "precommit": "vp run check",
    "prepush": "vp run check && vp test run --changed origin/main && vp run build && vp run --filter @template/infra-cloudflare verify:artifacts && vp run --filter @template/infra-cloudflare verify:stacks"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.45.0",
    "@shadcn/lint": "catalog:",
    "@swc/core": "1.16.2",
    "@template/config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.3.1",
    "effect": "catalog:",
    "knip": "6.35.1",
    "steiger": "0.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.4.1"
}
