{
  "name": "typescript-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && node tools/dev/src/prepare-browser.ts",
    "precommit": "vp run check",
    "prepush": "vp run check && vp test run --changed origin/main && vp run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.45.0",
    "@shadcn/lint": "catalog:",
    "@template/ai-native": "workspace:*",
    "@template/config": "workspace:*",
    "@template/db": "workspace:*",
    "@template/dont-review-it": "workspace:*",
    "@template/lint-rule-authoring": "workspace:*",
    "@template/monitor": "workspace:*",
    "@template/stop-ai-slop": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "knip": "6.35.1",
    "miniflare": "5.20260917.0-alpha",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "packageManager": "pnpm@12.4.1",
  "normativeDocuments": {
    "fileName": "AGENTS.md",
    "directories": [
      "apps/wiki/content/docs/guidelines"
    ]
  }
}
