{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "vitest.workers.main.ts",
    "infra/error-monitor/alchemy.run.ts",
    "infra/error-monitor/src/worker.ts",
    "infra/health-monitor/alchemy.run.ts",
    "infra/health-monitor/src/worker.ts",
    "libs/auth/src/browser-client.ts",
    "libs/auth/src/mail-fixture.ts",
    "libs/auth/src/testing.ts",
    "libs/monitor/src/mail-recorder.ts",
    "libs/observability/src/browser-testing.ts",
    "libs/observability/src/server-testing.ts",
    "libs/runtime/src/*-fixture.ts",
    "tools/dont-review-it/doctor.config.ts",
    "apps/core/alchemy.run.ts",
    "apps/core/src/worker.ts",
    "apps/internal-dashboard/alchemy.run.ts",
    "apps/internal-dashboard/src/app/{router,server,start}.{ts,tsx}",
    "apps/internal-dashboard/src/app/routes/**/*.{ts,tsx}",
    "apps/service-admin/alchemy.run.ts",
    "apps/service-admin/src/app/{router,server,start}.{ts,tsx}",
    "apps/service-admin/src/app/routes/**/*.{ts,tsx}",
    "apps/service-member/alchemy.run.ts",
    "apps/service-member/src/app/{router,server,start}.{ts,tsx}",
    "apps/service-member/src/app/routes/**/*.{ts,tsx}",
    "infra/budget-monitor/alchemy.run.ts",
    "infra/budget-monitor/src/worker.ts",
    "infra/cloudflare/src/database.ts",
    "infra/cloudflare/src/flagship.ts",
    "infra/cloudflare/src/email.ts",
    "infra/cloudflare/src/observability.ts",
    "infra/cloudflare/src/tokens.ts",
    "infra/cloudflare/src/storage.ts",
    "infra/cloudflare/src/zone.ts",
    "infra/cloudflare/src/bindings.ts",
    "libs/db/src/records-fixture.ts",
    "libs/vite-config/src/cloudflare-workers-stub.mjs",
    "libs/vite-config/src/cloudflare-workflows-stub.mjs",
    "tools/dev/src/gateway.ts",
    "tools/load/scenarios/*.ts",
    "vitest.mutation.config.ts",
    "vitest.workers.config.ts",
    "libs/ui/storybook/main.ts",
    "tools/dont-review-it/dependency-cruiser.ts",
    "tools/dont-review-it/src/repository/check-staged.ts",
    "tools/dont-review-it/src/repository/clean-shared-task-cache.ts",
    "tools/dont-review-it/src/repository/pr-affected.ts",
    "tools/dont-review-it/src/vitest/parsed-fields.ts",
    "libs/vite-config/src/{compile-paraglide,compile-workspace-paraglide}.ts"
  ],
  "ignorePatterns": ["**/routeTree.gen.ts", "libs/ui/storybook/public/mockServiceWorker.js"],
  "ignoreDependencies": [
    "@effect/tsgo",
    "@shadcn/lint",
    "@storybook/addon-mcp",
    "@stryker-mutator/vitest-runner",
    "@tanstack/intent",
    "agent-browser",
    "jiti",
    "oxc-transform-react",
    "playwright",
    "portless",
    "steiger",
    "textlint",
    "textlint-rule-preset-ai-words-ja",
    "zod"
  ],
  "usedClassMembers": ["fetch", "webSocketMessage"],
  "ignoreDependencyOverrides": [
    {
      "package": "valibot"
    },
    {
      "package": "@effect/platform-node-shared"
    },
    {
      "package": "zod-validation-error"
    }
  ],
  "ignoreExports": [
    {
      "file": "apps/*/src/shared/server-api/server-app.ts",
      "exports": ["app", "default"]
    },
    {
      "file": "apps/service-member/src/shared/inbox/binding.ts",
      "exports": ["userInboxClassName"]
    },
    {
      "file": "apps/service-member/src/shared/inbox/client.ts",
      "exports": ["publishFeedPost", "publishNotification"]
    },
    {
      "file": "apps/service-member/src/shared/inbox/index.ts",
      "exports": [
        "userInboxBinding",
        "userInboxClassName",
        "publishFeedPost",
        "publishNotification",
        "InboxBindings",
        "FeedPostRecord",
        "InboxEvent",
        "NotificationKind",
        "NotificationRecord"
      ]
    },
    {
      "file": "infra/cloudflare/src/credentials.ts",
      "exports": ["verifySecretsFile"]
    },
    {
      "file": "tools/dont-review-it/src/lint-rule-authoring/index.ts",
      "exports": ["testLintRule"]
    }
  ],
  "rules": {
    "boundary-violation": "off",
    "policy-violation": "off",
    "unused-dev-dependencies": "error",
    "unused-dependency-overrides": "error"
  },
  "health": {
    "maxCrap": 0,
    "thresholdOverrides": [
      {
        "files": ["tools/dont-review-it/src/repository/single-consumer.ts"],
        "functions": ["codeSpecifiers"],
        "maxCyclomatic": 30,
        "maxCognitive": 51
      },
      {
        "files": ["tools/dont-review-it/src/repository/staged.ts"],
        "functions": ["indexSecretHits"],
        "maxCognitive": 24
      },
      {
        "files": ["tools/dont-review-it/src/repository/scripts.ts"],
        "functions": ["assertBalancedShellQuotes"],
        "maxCognitive": 16
      }
    ]
  },
  "duplicates": {
    "threshold": 1.31
  }
}
