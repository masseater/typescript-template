{
  "extends": "@repo/dont-review-it/tsconfig/app.json",
  "compilerOptions": {
    "types": ["vite-plus/client", "@cloudflare/workers-types", "node"],
    "jsx": "react-jsx",
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    ".paraglide/**/*.ts",
    ".paraglide/**/*.js"
  ]
}
