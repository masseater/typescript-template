{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc --noEmit",
    "steiger": "steiger ./src",
    "db:generate": "drizzle-kit generate",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "auth:generate": "auth generate --config src/shared/auth/auth.server.ts --output src/shared/auth/generated/auth.table.ts --yes",
    "fallow": "fallow --production --quiet --format compact && fallow dupes --quiet --format compact && fallow security --fail-on-issues --quiet",
    "db:check": "drizzle-kit check && drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"'",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@effect/atom-react": "catalog:",
    "@elysiajs/eden": "1.4.9",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.59",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "eden-tanstack-react-query": "0.5.0",
    "effect": "catalog:",
    "elysia": "1.4.30",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "catalog:",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "alchemy": "2.0.0-beta.79",
    "auth": "1.7.6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "steiger": "0.7.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
