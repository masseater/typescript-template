{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http/FetchHttpClient#layer",
          "effect/observability/Otlp#layerFromConfig",
          "effect/observability/OtlpExporter#Flusher",
          "effect/observability/OtlpExporter#layerFlusher",
          "effect/observability/OtlpSerialization#layerJson",
          "effect/reactivity/Atom"
        ]
      }
    ]
  }
}
