{
  "name": "@template/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./security": "./src/security.ts",
    "./testing": "./src/testing.ts",
    "./remote": "./src/remote-command.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/user/wrangler.jsonc --persist-to ../../.local/d1",
    "db:bootstrap:local": "node src/bootstrap-local.ts",
    "db:migrate:remote": "node src/remote-cli.ts migrate",
    "db:bootstrap:remote": "node src/remote-cli.ts bootstrap"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "miniflare": "4.20260730.0",
    "valibot": "1.5.0",
    "wrangler": "4.132.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/node": "24.12.0",
    "drizzle-kit": "0.31.10",
    "msw": "^2.11.0",
    "typescript": "7.0.2"
  }
}
