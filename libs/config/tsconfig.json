{
  "extends": "@repo/dont-review-it/tsconfig/library.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
