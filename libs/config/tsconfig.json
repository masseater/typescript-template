{
  "extends": "@repo/dont-review-it/tsconfig/library.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
