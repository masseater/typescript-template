{
  "extends": "@repo/dont-review-it/tsconfig/app.json",
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
