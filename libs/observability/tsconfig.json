{
  "extends": "@repo/dont-review-it/tsconfig/app.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ],
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "../../tools/dont-review-it/src/vitest/parsed-fields.ts"
  ]
}
